theorem correlationPoint0_128 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 8) =
      fastR false (bits4 0) (bits4 8) := by decide +kernel

theorem trigPoint0_128 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 8))
      (fastR false (bits4 0) (bits4 8))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 8) j) := by decide +kernel

