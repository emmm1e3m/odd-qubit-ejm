def small7C97Set : Finset (Fin 7) := {0,1,6}

def small7C97Join (a : Fin 8) (b : Fin 16) : Fin 128 :=
  ⟨((a.val / 4 % 2) * 64 + (a.val / 2 % 2) * 32 + (a.val / 1 % 2) * 1 + (b.val / 8 % 2) * 16 + (b.val / 4 % 2) * 8 + (b.val / 2 % 2) * 4 + (b.val / 1 % 2) * 2) % 128, Nat.mod_lt _ (by decide)⟩

def small7C97Split (i : Fin 128) : Fin 8 × Fin 16 :=
  (⟨((i.val / 64 % 2) * 4 + (i.val / 32 % 2) * 2 + (i.val / 1 % 2) * 1) % 8, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 16 % 2) * 8 + (i.val / 8 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small7C97NatEquiv : (Fin 8 × Fin 16) ≃ Fin 128 where
  toFun := fun p => small7C97Join p.1 p.2
  invFun := small7C97Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small7C97Equiv : (Fin 8 × Fin 16) ≃ Bits 7 :=
  small7C97NatEquiv.trans smallIndexEquiv7

theorem small7C97_separate : ∀ a b j, small7C97Equiv (a,b) j =
    if j ∈ small7C97Set then small7C97Equiv (a,0) j else small7C97Equiv (0,b) j := by
  decide +kernel

theorem small7C97_mix (a ap : Fin 8) (b bp : Fin 16) :
    splice small7C97Set (small7C97Equiv (a,b)) (small7C97Equiv (ap,bp)) = small7C97Equiv (a,bp) :=
  layout_splice small7C97Set small7C97Equiv 0 0 small7C97_separate a ap b bp

