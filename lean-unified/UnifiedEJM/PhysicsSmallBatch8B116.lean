def small8C141Set : Finset (Fin 8) := {0,4,5,7}

def small8C141Join (a : Fin 16) (b : Fin 16) : Fin 256 :=
  ⟨((a.val / 8 % 2) * 128 + (a.val / 4 % 2) * 8 + (a.val / 2 % 2) * 4 + (a.val / 1 % 2) * 1 + (b.val / 8 % 2) * 64 + (b.val / 4 % 2) * 32 + (b.val / 2 % 2) * 16 + (b.val / 1 % 2) * 2) % 256, Nat.mod_lt _ (by decide)⟩

def small8C141Split (i : Fin 256) : Fin 16 × Fin 16 :=
  (⟨((i.val / 128 % 2) * 8 + (i.val / 8 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 1 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 64 % 2) * 8 + (i.val / 32 % 2) * 4 + (i.val / 16 % 2) * 2 + (i.val / 2 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small8C141NatEquiv : (Fin 16 × Fin 16) ≃ Fin 256 where
  toFun := fun p => small8C141Join p.1 p.2
  invFun := small8C141Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small8C141Equiv : (Fin 16 × Fin 16) ≃ Bits 8 :=
  small8C141NatEquiv.trans smallIndexEquiv8

theorem small8C141_separate : ∀ a b j, small8C141Equiv (a,b) j =
    if j ∈ small8C141Set then small8C141Equiv (a,0) j else small8C141Equiv (0,b) j := by
  decide +kernel

theorem small8C141_mix (a ap : Fin 16) (b bp : Fin 16) :
    splice small8C141Set (small8C141Equiv (a,b)) (small8C141Equiv (ap,bp)) = small8C141Equiv (a,bp) :=
  layout_splice small8C141Set small8C141Equiv 0 0 small8C141_separate a ap b bp

