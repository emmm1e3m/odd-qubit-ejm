def small7C9Set : Finset (Fin 7) := {3,6}

def small7C9Join (a : Fin 4) (b : Fin 32) : Fin 128 :=
  ⟨((a.val / 2 % 2) * 8 + (a.val / 1 % 2) * 1 + (b.val / 16 % 2) * 64 + (b.val / 8 % 2) * 32 + (b.val / 4 % 2) * 16 + (b.val / 2 % 2) * 4 + (b.val / 1 % 2) * 2) % 128, Nat.mod_lt _ (by decide)⟩

def small7C9Split (i : Fin 128) : Fin 4 × Fin 32 :=
  (⟨((i.val / 8 % 2) * 2 + (i.val / 1 % 2) * 1) % 4, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 64 % 2) * 16 + (i.val / 32 % 2) * 8 + (i.val / 16 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 32, Nat.mod_lt _ (by decide)⟩)

def small7C9NatEquiv : (Fin 4 × Fin 32) ≃ Fin 128 where
  toFun := fun p => small7C9Join p.1 p.2
  invFun := small7C9Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small7C9Equiv : (Fin 4 × Fin 32) ≃ Bits 7 :=
  small7C9NatEquiv.trans smallIndexEquiv7

theorem small7C9_separate : ∀ a b j, small7C9Equiv (a,b) j =
    if j ∈ small7C9Set then small7C9Equiv (a,0) j else small7C9Equiv (0,b) j := by
  decide +kernel

theorem small7C9_mix (a ap : Fin 4) (b bp : Fin 32) :
    splice small7C9Set (small7C9Equiv (a,b)) (small7C9Equiv (ap,bp)) = small7C9Equiv (a,bp) :=
  layout_splice small7C9Set small7C9Equiv 0 0 small7C9_separate a ap b bp

