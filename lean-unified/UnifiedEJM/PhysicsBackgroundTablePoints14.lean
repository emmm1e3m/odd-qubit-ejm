theorem correlationPoint1_192 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 12) =
      fastR true (bits4 0) (bits4 12) := by decide +kernel

theorem trigPoint1_192 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 12))
      (fastR true (bits4 0) (bits4 12))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 12) j) := by decide +kernel

