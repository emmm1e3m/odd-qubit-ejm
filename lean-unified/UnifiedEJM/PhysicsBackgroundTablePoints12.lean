theorem correlationPoint1_128 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 8) =
      fastR true (bits4 0) (bits4 8) := by decide +kernel

theorem trigPoint1_128 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 8))
      (fastR true (bits4 0) (bits4 8))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 8) j) := by decide +kernel

