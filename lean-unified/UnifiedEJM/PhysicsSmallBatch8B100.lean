def small8C180Set : Finset (Fin 8) := {0,2,3,5}

def small8C180Join (a : Fin 16) (b : Fin 16) : Fin 256 :=
  ⟨((a.val / 8 % 2) * 128 + (a.val / 4 % 2) * 32 + (a.val / 2 % 2) * 16 + (a.val / 1 % 2) * 4 + (b.val / 8 % 2) * 64 + (b.val / 4 % 2) * 8 + (b.val / 2 % 2) * 2 + (b.val / 1 % 2) * 1) % 256, Nat.mod_lt _ (by decide)⟩

def small8C180Split (i : Fin 256) : Fin 16 × Fin 16 :=
  (⟨((i.val / 128 % 2) * 8 + (i.val / 32 % 2) * 4 + (i.val / 16 % 2) * 2 + (i.val / 4 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 64 % 2) * 8 + (i.val / 8 % 2) * 4 + (i.val / 2 % 2) * 2 + (i.val / 1 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small8C180NatEquiv : (Fin 16 × Fin 16) ≃ Fin 256 where
  toFun := fun p => small8C180Join p.1 p.2
  invFun := small8C180Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small8C180Equiv : (Fin 16 × Fin 16) ≃ Bits 8 :=
  small8C180NatEquiv.trans smallIndexEquiv8

theorem small8C180_separate : ∀ a b j, small8C180Equiv (a,b) j =
    if j ∈ small8C180Set then small8C180Equiv (a,0) j else small8C180Equiv (0,b) j := by
  decide +kernel

theorem small8C180_mix (a ap : Fin 16) (b bp : Fin 16) :
    splice small8C180Set (small8C180Equiv (a,b)) (small8C180Equiv (ap,bp)) = small8C180Equiv (a,bp) :=
  layout_splice small8C180Set small8C180Equiv 0 0 small8C180_separate a ap b bp

