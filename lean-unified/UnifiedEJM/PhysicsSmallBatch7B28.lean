def small7C81Set : Finset (Fin 7) := {0,2,6}

def small7C81Join (a : Fin 8) (b : Fin 16) : Fin 128 :=
  ⟨((a.val / 4 % 2) * 64 + (a.val / 2 % 2) * 16 + (a.val / 1 % 2) * 1 + (b.val / 8 % 2) * 32 + (b.val / 4 % 2) * 8 + (b.val / 2 % 2) * 4 + (b.val / 1 % 2) * 2) % 128, Nat.mod_lt _ (by decide)⟩

def small7C81Split (i : Fin 128) : Fin 8 × Fin 16 :=
  (⟨((i.val / 64 % 2) * 4 + (i.val / 16 % 2) * 2 + (i.val / 1 % 2) * 1) % 8, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 32 % 2) * 8 + (i.val / 8 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small7C81NatEquiv : (Fin 8 × Fin 16) ≃ Fin 128 where
  toFun := fun p => small7C81Join p.1 p.2
  invFun := small7C81Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small7C81Equiv : (Fin 8 × Fin 16) ≃ Bits 7 :=
  small7C81NatEquiv.trans smallIndexEquiv7

theorem small7C81_separate : ∀ a b j, small7C81Equiv (a,b) j =
    if j ∈ small7C81Set then small7C81Equiv (a,0) j else small7C81Equiv (0,b) j := by
  decide +kernel

theorem small7C81_mix (a ap : Fin 8) (b bp : Fin 16) :
    splice small7C81Set (small7C81Equiv (a,b)) (small7C81Equiv (ap,bp)) = small7C81Equiv (a,bp) :=
  layout_splice small7C81Set small7C81Equiv 0 0 small7C81_separate a ap b bp

