set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

theorem correlationPoint1_96 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 6) =
      fastR true (bits4 0) (bits4 6) := by decide +kernel

theorem trigPoint1_96 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 6))
      (fastR true (bits4 0) (bits4 6))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 6) j) := by decide +kernel

