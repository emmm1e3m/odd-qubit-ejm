theorem correlationPoint1_224 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 14) =
      fastR true (bits4 0) (bits4 14) := by decide +kernel

theorem trigPoint1_224 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 14))
      (fastR true (bits4 0) (bits4 14))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 14) j) := by decide +kernel

