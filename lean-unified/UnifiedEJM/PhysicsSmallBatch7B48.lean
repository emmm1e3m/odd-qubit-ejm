def small7C22Set : Finset (Fin 7) := {2,4,5}

def small7C22Join (a : Fin 8) (b : Fin 16) : Fin 128 :=
  ⟨((a.val / 4 % 2) * 16 + (a.val / 2 % 2) * 4 + (a.val / 1 % 2) * 2 + (b.val / 8 % 2) * 64 + (b.val / 4 % 2) * 32 + (b.val / 2 % 2) * 8 + (b.val / 1 % 2) * 1) % 128, Nat.mod_lt _ (by decide)⟩

def small7C22Split (i : Fin 128) : Fin 8 × Fin 16 :=
  (⟨((i.val / 16 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 8, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 64 % 2) * 8 + (i.val / 32 % 2) * 4 + (i.val / 8 % 2) * 2 + (i.val / 1 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small7C22NatEquiv : (Fin 8 × Fin 16) ≃ Fin 128 where
  toFun := fun p => small7C22Join p.1 p.2
  invFun := small7C22Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small7C22Equiv : (Fin 8 × Fin 16) ≃ Bits 7 :=
  small7C22NatEquiv.trans smallIndexEquiv7

theorem small7C22_separate : ∀ a b j, small7C22Equiv (a,b) j =
    if j ∈ small7C22Set then small7C22Equiv (a,0) j else small7C22Equiv (0,b) j := by
  decide +kernel

theorem small7C22_mix (a ap : Fin 8) (b bp : Fin 16) :
    splice small7C22Set (small7C22Equiv (a,b)) (small7C22Equiv (ap,bp)) = small7C22Equiv (a,bp) :=
  layout_splice small7C22Set small7C22Equiv 0 0 small7C22_separate a ap b bp

