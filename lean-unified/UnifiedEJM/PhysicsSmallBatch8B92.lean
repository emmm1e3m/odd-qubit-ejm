def small8C209Set : Finset (Fin 8) := {0,1,3,7}

def small8C209Join (a : Fin 16) (b : Fin 16) : Fin 256 :=
  ⟨((a.val / 8 % 2) * 128 + (a.val / 4 % 2) * 64 + (a.val / 2 % 2) * 16 + (a.val / 1 % 2) * 1 + (b.val / 8 % 2) * 32 + (b.val / 4 % 2) * 8 + (b.val / 2 % 2) * 4 + (b.val / 1 % 2) * 2) % 256, Nat.mod_lt _ (by decide)⟩

def small8C209Split (i : Fin 256) : Fin 16 × Fin 16 :=
  (⟨((i.val / 128 % 2) * 8 + (i.val / 64 % 2) * 4 + (i.val / 16 % 2) * 2 + (i.val / 1 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 32 % 2) * 8 + (i.val / 8 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small8C209NatEquiv : (Fin 16 × Fin 16) ≃ Fin 256 where
  toFun := fun p => small8C209Join p.1 p.2
  invFun := small8C209Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small8C209Equiv : (Fin 16 × Fin 16) ≃ Bits 8 :=
  small8C209NatEquiv.trans smallIndexEquiv8

theorem small8C209_separate : ∀ a b j, small8C209Equiv (a,b) j =
    if j ∈ small8C209Set then small8C209Equiv (a,0) j else small8C209Equiv (0,b) j := by
  decide +kernel

theorem small8C209_mix (a ap : Fin 16) (b bp : Fin 16) :
    splice small8C209Set (small8C209Equiv (a,b)) (small8C209Equiv (ap,bp)) = small8C209Equiv (a,bp) :=
  layout_splice small8C209Set small8C209Equiv 0 0 small8C209_separate a ap b bp

