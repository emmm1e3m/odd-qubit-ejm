def small8C14Set : Finset (Fin 8) := {4,5,6}

def small8C14Join (a : Fin 8) (b : Fin 32) : Fin 256 :=
  ⟨((a.val / 4 % 2) * 8 + (a.val / 2 % 2) * 4 + (a.val / 1 % 2) * 2 + (b.val / 16 % 2) * 128 + (b.val / 8 % 2) * 64 + (b.val / 4 % 2) * 32 + (b.val / 2 % 2) * 16 + (b.val / 1 % 2) * 1) % 256, Nat.mod_lt _ (by decide)⟩

def small8C14Split (i : Fin 256) : Fin 8 × Fin 32 :=
  (⟨((i.val / 8 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 8, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 128 % 2) * 16 + (i.val / 64 % 2) * 8 + (i.val / 32 % 2) * 4 + (i.val / 16 % 2) * 2 + (i.val / 1 % 2) * 1) % 32, Nat.mod_lt _ (by decide)⟩)

def small8C14NatEquiv : (Fin 8 × Fin 32) ≃ Fin 256 where
  toFun := fun p => small8C14Join p.1 p.2
  invFun := small8C14Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small8C14Equiv : (Fin 8 × Fin 32) ≃ Bits 8 :=
  small8C14NatEquiv.trans smallIndexEquiv8

theorem small8C14_separate : ∀ a b j, small8C14Equiv (a,b) j =
    if j ∈ small8C14Set then small8C14Equiv (a,0) j else small8C14Equiv (0,b) j := by
  decide +kernel

theorem small8C14_mix (a ap : Fin 8) (b bp : Fin 32) :
    splice small8C14Set (small8C14Equiv (a,b)) (small8C14Equiv (ap,bp)) = small8C14Equiv (a,bp) :=
  layout_splice small8C14Set small8C14Equiv 0 0 small8C14_separate a ap b bp

