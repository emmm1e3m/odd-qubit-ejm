theorem correlationPoint0_224 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 14) =
      fastR false (bits4 0) (bits4 14) := by decide +kernel

theorem trigPoint0_224 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 14))
      (fastR false (bits4 0) (bits4 14))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 14) j) := by decide +kernel

