def canonicalMask5 (k : Fin 15) : Fin 32 := ⟨k.val+1, by omega⟩
def canonicalMask6 (k : Fin 31) : Fin 64 := ⟨k.val+1, by omega⟩
def canonicalCut5 (k : Fin 15) : Finset (Fin 5) := cutSet 5 (canonicalMask5 k)
def canonicalCut6 (k : Fin 31) : Finset (Fin 6) := cutSet 6 (canonicalMask6 k)

theorem cut5_enumeration : ∀ S ∈ Multipartite.cuts 5, ∃ k : Fin 15,
    S = canonicalCut5 k ∨ S = (canonicalCut5 k)ᶜ := by decide +kernel

theorem cut6_enumeration : ∀ S ∈ Multipartite.cuts 6, ∃ k : Fin 31,
    S = canonicalCut6 k ∨ S = (canonicalCut6 k)ᶜ := by decide +kernel

