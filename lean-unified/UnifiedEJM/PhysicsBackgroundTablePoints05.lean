theorem correlationPoint0_160 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 10) =
      fastR false (bits4 0) (bits4 10) := by decide +kernel

theorem trigPoint0_160 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 10))
      (fastR false (bits4 0) (bits4 10))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 10) j) := by decide +kernel

