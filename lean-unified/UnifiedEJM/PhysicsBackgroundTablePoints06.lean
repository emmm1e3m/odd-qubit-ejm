theorem correlationPoint0_192 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 12) =
      fastR false (bits4 0) (bits4 12) := by decide +kernel

theorem trigPoint0_192 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 12))
      (fastR false (bits4 0) (bits4 12))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 12) j) := by decide +kernel

