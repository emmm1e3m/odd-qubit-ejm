theorem fastR_trig (odd : Bool) (d k : Bits 4) :
    realCoeffs (coefficientTerm (fastR odd d k) (fastR odd d k)) =
      fun q => 16384 * fastTrig odd d k q := by
  simpa only [bits4_indexFin4] using fastR_trig_index odd (indexFin4 d) (indexFin4 k)

theorem squaredCoeffs_trig (odd : Bool) (d k : Bits 4) :
    realCoeffs (squaredCoeffs (coefficientA odd) (coefficientB odd) d k) =
      fun j => 16384 * fastTrig odd d k j := by
  have ha : coefficientA odd = fastA odd := funext (coefficientA_fast odd)
  have hb : coefficientB odd = fastB odd := funext (coefficientB_fast odd)
  simp only [squaredCoeffs, ha, hb, correlationCoeffs_fast]
  exact fastR_trig odd d k

