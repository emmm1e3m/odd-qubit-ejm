theorem correlationPoint1_160 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 10) =
      fastR true (bits4 0) (bits4 10) := by decide +kernel

theorem trigPoint1_160 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 10))
      (fastR true (bits4 0) (bits4 10))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 10) j) := by decide +kernel

