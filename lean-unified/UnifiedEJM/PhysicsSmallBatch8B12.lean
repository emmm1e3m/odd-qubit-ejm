def small8C65Set : Finset (Fin 8) := {1,7}

def small8C65Join (a : Fin 4) (b : Fin 64) : Fin 256 :=
  ⟨((a.val / 2 % 2) * 64 + (a.val / 1 % 2) * 1 + (b.val / 32 % 2) * 128 + (b.val / 16 % 2) * 32 + (b.val / 8 % 2) * 16 + (b.val / 4 % 2) * 8 + (b.val / 2 % 2) * 4 + (b.val / 1 % 2) * 2) % 256, Nat.mod_lt _ (by decide)⟩

def small8C65Split (i : Fin 256) : Fin 4 × Fin 64 :=
  (⟨((i.val / 64 % 2) * 2 + (i.val / 1 % 2) * 1) % 4, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 128 % 2) * 32 + (i.val / 32 % 2) * 16 + (i.val / 16 % 2) * 8 + (i.val / 8 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 2 % 2) * 1) % 64, Nat.mod_lt _ (by decide)⟩)

def small8C65NatEquiv : (Fin 4 × Fin 64) ≃ Fin 256 where
  toFun := fun p => small8C65Join p.1 p.2
  invFun := small8C65Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small8C65Equiv : (Fin 4 × Fin 64) ≃ Bits 8 :=
  small8C65NatEquiv.trans smallIndexEquiv8

theorem small8C65_separate : ∀ a b j, small8C65Equiv (a,b) j =
    if j ∈ small8C65Set then small8C65Equiv (a,0) j else small8C65Equiv (0,b) j := by
  decide +kernel

theorem small8C65_mix (a ap : Fin 4) (b bp : Fin 64) :
    splice small8C65Set (small8C65Equiv (a,b)) (small8C65Equiv (ap,bp)) = small8C65Equiv (a,bp) :=
  layout_splice small8C65Set small8C65Equiv 0 0 small8C65_separate a ap b bp

