def small8C37Set : Finset (Fin 8) := {2,5,7}

def small8C37Join (a : Fin 8) (b : Fin 32) : Fin 256 :=
  ⟨((a.val / 4 % 2) * 32 + (a.val / 2 % 2) * 4 + (a.val / 1 % 2) * 1 + (b.val / 16 % 2) * 128 + (b.val / 8 % 2) * 64 + (b.val / 4 % 2) * 16 + (b.val / 2 % 2) * 8 + (b.val / 1 % 2) * 2) % 256, Nat.mod_lt _ (by decide)⟩

def small8C37Split (i : Fin 256) : Fin 8 × Fin 32 :=
  (⟨((i.val / 32 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 1 % 2) * 1) % 8, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 128 % 2) * 16 + (i.val / 64 % 2) * 8 + (i.val / 16 % 2) * 4 + (i.val / 8 % 2) * 2 + (i.val / 2 % 2) * 1) % 32, Nat.mod_lt _ (by decide)⟩)

def small8C37NatEquiv : (Fin 8 × Fin 32) ≃ Fin 256 where
  toFun := fun p => small8C37Join p.1 p.2
  invFun := small8C37Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small8C37Equiv : (Fin 8 × Fin 32) ≃ Bits 8 :=
  small8C37NatEquiv.trans smallIndexEquiv8

theorem small8C37_separate : ∀ a b j, small8C37Equiv (a,b) j =
    if j ∈ small8C37Set then small8C37Equiv (a,0) j else small8C37Equiv (0,b) j := by
  decide +kernel

theorem small8C37_mix (a ap : Fin 8) (b bp : Fin 32) :
    splice small8C37Set (small8C37Equiv (a,b)) (small8C37Equiv (ap,bp)) = small8C37Equiv (a,bp) :=
  layout_splice small8C37Set small8C37Equiv 0 0 small8C37_separate a ap b bp

