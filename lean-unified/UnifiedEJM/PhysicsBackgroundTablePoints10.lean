set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

theorem correlationPoint1_64 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 4) =
      fastR true (bits4 0) (bits4 4) := by decide +kernel

theorem trigPoint1_64 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 4))
      (fastR true (bits4 0) (bits4 4))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 4) j) := by decide +kernel

