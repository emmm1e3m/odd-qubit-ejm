def small7C42Set : Finset (Fin 7) := {1,3,5}

def small7C42Join (a : Fin 8) (b : Fin 16) : Fin 128 :=
  ⟨((a.val / 4 % 2) * 32 + (a.val / 2 % 2) * 8 + (a.val / 1 % 2) * 2 + (b.val / 8 % 2) * 64 + (b.val / 4 % 2) * 16 + (b.val / 2 % 2) * 4 + (b.val / 1 % 2) * 1) % 128, Nat.mod_lt _ (by decide)⟩

def small7C42Split (i : Fin 128) : Fin 8 × Fin 16 :=
  (⟨((i.val / 32 % 2) * 4 + (i.val / 8 % 2) * 2 + (i.val / 2 % 2) * 1) % 8, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 64 % 2) * 8 + (i.val / 16 % 2) * 4 + (i.val / 4 % 2) * 2 + (i.val / 1 % 2) * 1) % 16, Nat.mod_lt _ (by decide)⟩)

def small7C42NatEquiv : (Fin 8 × Fin 16) ≃ Fin 128 where
  toFun := fun p => small7C42Join p.1 p.2
  invFun := small7C42Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small7C42Equiv : (Fin 8 × Fin 16) ≃ Bits 7 :=
  small7C42NatEquiv.trans smallIndexEquiv7

theorem small7C42_separate : ∀ a b j, small7C42Equiv (a,b) j =
    if j ∈ small7C42Set then small7C42Equiv (a,0) j else small7C42Equiv (0,b) j := by
  decide +kernel

theorem small7C42_mix (a ap : Fin 8) (b bp : Fin 16) :
    splice small7C42Set (small7C42Equiv (a,b)) (small7C42Equiv (ap,bp)) = small7C42Equiv (a,bp) :=
  layout_splice small7C42Set small7C42Equiv 0 0 small7C42_separate a ap b bp

