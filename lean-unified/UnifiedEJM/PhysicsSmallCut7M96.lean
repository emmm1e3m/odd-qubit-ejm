def small7C96Set : Finset (Fin 7) := {0,1}

def small7C96Join (a : Fin 4) (b : Fin 32) : Fin 128 :=
  ⟨((a.val / 2 % 2) * 64 + (a.val / 1 % 2) * 32 + (b.val / 16 % 2) * 16 + (b.val / 8 % 2) * 8 + (b.val / 4 % 2) * 4 + (b.val / 2 % 2) * 2 + (b.val / 1 % 2) * 1) % 128, Nat.mod_lt _ (by decide)⟩

def small7C96Split (i : Fin 128) : Fin 4 × Fin 32 :=
  (⟨((i.val / 64 % 2) * 2 + (i.val / 32 % 2) * 1) % 4, Nat.mod_lt _ (by decide)⟩,
   ⟨((i.val / 16 % 2) * 16 + (i.val / 8 % 2) * 8 + (i.val / 4 % 2) * 4 + (i.val / 2 % 2) * 2 + (i.val / 1 % 2) * 1) % 32, Nat.mod_lt _ (by decide)⟩)

def small7C96NatEquiv : (Fin 4 × Fin 32) ≃ Fin 128 where
  toFun := fun p => small7C96Join p.1 p.2
  invFun := small7C96Split
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def small7C96Equiv : (Fin 4 × Fin 32) ≃ Bits 7 :=
  small7C96NatEquiv.trans smallIndexEquiv7

theorem small7C96_separate : ∀ a b j, small7C96Equiv (a,b) j =
    if j ∈ small7C96Set then small7C96Equiv (a,0) j else small7C96Equiv (0,b) j := by
  decide +kernel

theorem small7C96_mix (a ap : Fin 4) (b bp : Fin 32) :
    splice small7C96Set (small7C96Equiv (a,b)) (small7C96Equiv (ap,bp)) = small7C96Equiv (a,bp) :=
  layout_splice small7C96Set small7C96Equiv 0 0 small7C96_separate a ap b bp

