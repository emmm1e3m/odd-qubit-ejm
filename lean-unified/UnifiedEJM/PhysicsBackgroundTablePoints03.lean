theorem correlationPoint0_96 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 6) =
      fastR false (bits4 0) (bits4 6) := by decide +kernel

theorem trigPoint0_96 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 6))
      (fastR false (bits4 0) (bits4 6))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 6) j) := by decide +kernel

