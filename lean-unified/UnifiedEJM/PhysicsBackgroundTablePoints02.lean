theorem correlationPoint0_64 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 4) =
      fastR false (bits4 0) (bits4 4) := by decide +kernel

theorem trigPoint0_64 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 4))
      (fastR false (bits4 0) (bits4 4))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 4) j) := by decide +kernel

