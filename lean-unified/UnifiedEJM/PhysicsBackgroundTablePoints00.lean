import UnifiedEJM.PhysicsBackgroundTableData

open OddEJM
open scoped BigOperators
namespace UnifiedEJM.WeightedTransfer.SparseCertificate
open PhysicsFinite PhysicsEntanglement
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

theorem correlationPoint0_0 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 0) =
      fastR false (bits4 0) (bits4 0) := by decide +kernel

theorem trigPoint0_0 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 0))
      (fastR false (bits4 0) (bits4 0))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 0) j) := by decide +kernel

