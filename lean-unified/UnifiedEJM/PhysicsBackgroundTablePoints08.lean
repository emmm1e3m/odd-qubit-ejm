import UnifiedEJM.PhysicsBackgroundTableData

open OddEJM
open scoped BigOperators
namespace UnifiedEJM.WeightedTransfer.SparseCertificate
open PhysicsFinite PhysicsEntanglement
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

theorem correlationPoint1_0 :
    correlationCoeffs (fastA true) (fastB true) (bits4 0) (bits4 0) =
      fastR true (bits4 0) (bits4 0) := by decide +kernel

theorem trigPoint1_0 :
    realCoeffs (coefficientTerm (fastR true (bits4 0) (bits4 0))
      (fastR true (bits4 0) (bits4 0))) =
      (fun j => 16384 * fastTrig true (bits4 0) (bits4 0) j) := by decide +kernel

