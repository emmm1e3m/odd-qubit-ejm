theorem correlationPoint0_32 :
    correlationCoeffs (fastA false) (fastB false) (bits4 0) (bits4 2) =
      fastR false (bits4 0) (bits4 2) := by decide +kernel

theorem trigPoint0_32 :
    realCoeffs (coefficientTerm (fastR false (bits4 0) (bits4 2))
      (fastR false (bits4 0) (bits4 2))) =
      (fun j => 16384 * fastTrig false (bits4 0) (bits4 2) j) := by decide +kernel

